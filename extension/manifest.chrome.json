{
  "manifest_version": 3,
  "name": "zenTTS",
  "version": "1.1.1",
  "description": "Reads pages aloud, sentence by sentence: fanfics, articles, PDFs. Native, neural or offline voices, plus offline translation.",
  "author": "JoVi-Yashi",
  "homepage_url": "https://github.com/JoVi-Yashi/zenTTs",
  "permissions": [
    "storage",
    "activeTab",
    "unlimitedStorage",
    "theme"
  ],
  "host_permissions": [
    "http://localhost:8765/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://storage.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "zenTTS · clic para mostrar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/sites/*.svg",
        "icons/sites/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Show or hide the zenTTS panel in this tab"
    }
  }
}
