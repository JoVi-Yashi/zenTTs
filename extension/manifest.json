{
  "manifest_version": 3,
  "name": "TTS-zen",
  "version": "0.4.0",
  "description": "Floating TTS panel — read any page aloud. Native SpeechSynthesis or edge-tts neural voices. Wattpad, AO3, FanFiction support.",
  "author": "JoVi-Yashi",
  "homepage_url": "https://github.com/JoVi-Yashi/zenTTs",
  "browser_specific_settings": {
    "gecko": {
      "id": "tts-zen@gentle-ai.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "data_collection_permissions": {
    "usage": "none"
  },
  "host_permissions": [
    "http://localhost:8765/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "TTS-zen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
