{
  "manifest_version": 3,
  "name": "zenTTS",
  "version": "1.0.0",
  "description": "Reads the page aloud, sentence by sentence, marking where it is: fanfics, articles and PDFs. Browser, neural (edge-tts) or offline (Piper) voices, and offline translation.",
  "author": "JoVi-Yashi",
  "homepage_url": "https://github.com/JoVi-Yashi/zenTTs",
  "browser_specific_settings": {
    "gecko": {
      "id": "zentts@jovi-yashi.addons.mozilla.org",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "usage": "none",
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "unlimitedStorage",
    "theme"
  ],
  "host_permissions": [
    "http://localhost:8765/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://storage.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "zenTTS · clic para mostrar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/sites/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Show or hide the zenTTS panel in this tab"
    }
  }
}
