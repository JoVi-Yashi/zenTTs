[Desktop Entry]
Name=TTS-zen
Name[es]=TTS-zen
Comment=Text-to-speech for Zen Browser
Comment[es]=Texto a voz para Zen Browser
Exec=bash -c '"$HOME/Proyectos/TTS-zen/launcher.sh" start; read -p "Presioná Enter para cerrar..."'
Icon=tts-zen
Terminal=true
Type=Application
Categories=Audio;Utility;
Keywords=tts;text-to-speech;voz;lectura;zen;browser;
StartupNotify=true
